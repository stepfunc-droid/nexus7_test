# Diskless v2 ARM cross-toolchain baseline.
#
# Linux 3.4 in the flo Lineage kernel predates modern GCC compatibility
# headers. Do not compile it with the host distro's current GCC.

TOOLCHAIN_REPOSITORY=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9.git
TOOLCHAIN_REF=lineage-18.1
TOOLCHAIN_COMMIT=da10d2bd65e2c57d338fb6bb712ff522ad4e34e7
TOOLCHAIN_PREFIX=arm-linux-androideabi-
TOOLCHAIN_GCC_MAJOR=4
TOOLCHAIN_GCC_MINOR=9
