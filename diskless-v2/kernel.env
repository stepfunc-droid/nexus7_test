# Diskless v2 kernel source baseline.
#
# All v2 kernel builds must start from this exact upstream commit. The only
# tracked source modification allowed before build is the repository-managed
# SDCC1/eMMC disable patch in board-flo-storage.c.

KERNEL_REPOSITORY=https://github.com/LineageOS/android_kernel_google_msm.git
KERNEL_REF=lineage-18.1
KERNEL_BASE_COMMIT=0da5107137f93b8d8f697e949ab0784f5ace450c
KERNEL_DEFCONFIG=lineageos_flo_defconfig
