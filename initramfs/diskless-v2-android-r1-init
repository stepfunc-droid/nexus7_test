#!/diskless-busybox sh
set -u

BB=/diskless-busybox
HOST=172.16.42.2
PORT=10810
NEXUS_IP=172.16.42.1
LAYOUT=/diskless-v2-layout

fail() {
    echo "diskless-v2 6R1 FAIL: $*" > /dev/console 2>/dev/null || true
    while true; do
        $BB sleep 3600
    done
}

node() {
    path="$1" type="$2" major="$3" minor="$4" mode="$5"
    [ -e "$path" ] || $BB mknod "$path" "$type" "$major" "$minor"
    $BB chmod "$mode" "$path" 2>/dev/null || true
}

nbd_kernel_pid() {
    [ -r /sys/block/nbd0/pid ] || return 1
    pid="$($BB cat /sys/block/nbd0/pid 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*|0) return 1 ;;
        *) echo "$pid" ;;
    esac
}

partition_sectors() {
    dev="$1"
    $BB awk -v d="$dev" '$4 == d { print $3 * 2; exit }' /proc/partitions
}

nbd_alive() {
    pid="$(nbd_kernel_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    sectors="$(partition_sectors nbd0)"
    [ -n "$sectors" ] && [ "$sectors" -gt 0 ] 2>/dev/null
}

validate_partition() {
    dev="$1" expected="$2"
    actual="$(partition_sectors "$dev")"
    [ -n "$actual" ] || fail "$dev missing from /proc/partitions"
    [ "$actual" = "$expected" ] || fail "$dev sectors=$actual expected=$expected"
}

$BB mkdir -p /proc /sys /dev
$BB mount -t proc proc /proc || fail "mount /proc failed"
$BB mount -t sysfs sysfs /sys || fail "mount /sys failed"

# daemon(0,0) in BusyBox nbd-client needs /dev/null. /dev/console is used only
# for pre-handoff fatal diagnostics and is never kept open across exec /init.
node /dev/null c 1 3 666
node /dev/console c 5 1 600

# Linux 3.4 NBD with nbd.max_part=8 allocates 16 minors for nbd0.
node /dev/nbd0 b 43 0 600
i=1
while [ "$i" -le 15 ]; do
    node "/dev/nbd0p$i" b 43 "$i" 600
    i=$((i + 1))
done

[ -r "$LAYOUT" ] || fail "layout contract missing"
. "$LAYOUT"

[ -w /proc/sys/kernel/panic_on_oops ] && echo 1 > /proc/sys/kernel/panic_on_oops
[ -w /proc/sys/kernel/panic ] && echo 5 > /proc/sys/kernel/panic

i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 60 ]; do
    $BB sleep 1
    i=$((i + 1))
done
[ -e /sys/class/net/usb0 ] || fail "usb0 did not appear"
$BB ifconfig usb0 "$NEXUS_IP" netmask 255.255.255.0 up || fail "ifconfig usb0 failed"

# Start nbd-client synchronously. On MMU BusyBox it daemonizes after NBD_SET_SOCK
# and leaves exactly one long-lived userspace handler blocked in NBD_DO_IT.
# No shell background pipeline, logger, httpd, nc or marker process is created.
attempt=0
while [ "$attempt" -lt 12 ]; do
    if nbd_alive; then
        break
    fi

    $BB nbd-client "$HOST" "$PORT" /dev/nbd0 >/dev/null 2>&1 || true

    j=0
    while [ "$j" -lt 20 ]; do
        nbd_alive && break
        $BB usleep 250000
        j=$((j + 1))
    done
    nbd_alive && break

    # Do not open another connection while the kernel still reports a live
    # handler or non-zero capacity from the previous attempt.
    pid="$(nbd_kernel_pid 2>/dev/null || true)"
    sectors="$(partition_sectors nbd0)"
    if [ -n "$pid" ] || { [ -n "$sectors" ] && [ "$sectors" -gt 0 ] 2>/dev/null; }; then
        fail "partial NBD state after attach attempt"
    fi

    attempt=$((attempt + 1))
done
nbd_alive || fail "nbd0 did not establish"

if $BB --list | $BB grep -qx blockdev; then
    $BB blockdev --rereadpt /dev/nbd0 >/dev/null 2>&1 || true
fi

i=0
while [ "$i" -lt 80 ]; do
    ok=1
    for p in 1 2 3 5 6 7; do
        $BB grep -qE "[[:space:]]nbd0p${p}$" /proc/partitions || ok=0
    done
    [ "$ok" = 1 ] && break
    $BB dd if=/dev/nbd0p1 of=/dev/null bs=512 count=1 >/dev/null 2>&1 || true
    $BB usleep 250000
    i=$((i + 1))
done

validate_partition nbd0p1 "$P1_SECTORS"
validate_partition nbd0p2 "$P2_SECTORS"
validate_partition nbd0p3 "$P3_SECTORS"
validate_partition nbd0p5 "$P5_SECTORS"
validate_partition nbd0p6 "$P6_SECTORS"
validate_partition nbd0p7 "$P7_SECTORS"

# No descriptor from proc/sys is intentionally retained. Normal unmount must
# succeed; otherwise do not contaminate Android's first-stage namespace.
$BB umount /sys || fail "umount /sys failed before Android handoff"
$BB umount /proc || fail "umount /proc failed before Android handoff"

# PID 1 becomes the exact stock Lineage /init. The only intended surviving
# userspace process is the BusyBox NBD handler required by root storage.
exec /init
