#!/bin/busybox sh

BB=/bin/busybox
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /run /tmp /sys/kernel/config

$BB echo
$BB echo "=== Nexus 7 flo RAM-only test ==="
$BB echo "Kernel: $($BB uname -a)"
$BB echo "cmdline: $($BB cat /proc/cmdline)"
$BB echo

if $BB ls /dev/mmcblk* >/dev/null 2>&1; then
    $BB echo "WARNING: mmc block device exists; this build is NOT safe for the intended test."
    $BB ls -l /dev/mmcblk*
else
    $BB echo "OK: no /dev/mmcblk* devices"
fi

if $BB grep -qiE 'mmcblk|sdhci|sdcc' /proc/partitions 2>/dev/null; then
    $BB echo "WARNING: MMC-like entry present in /proc/partitions"
    $BB cat /proc/partitions
else
    $BB echo "OK: /proc/partitions contains no MMC block device"
fi

load_usb_gadget_modules() {
    # The postmarketOS APQ8064 kernel has the UDC built in, but libcomposite,
    # configfs and the Ethernet gadget functions are modules. The runtime
    # builder copies the matching module tree into this initramfs.
    for mod in libcomposite usb_f_ecm usb_f_ncm usb_f_rndis; do
        if $BB modprobe "$mod" >/dev/null 2>&1; then
            $BB echo "USB module loaded: $mod"
        else
            $BB echo "USB module unavailable: $mod"
        fi
    done
}

start_usb_shell() {
    load_usb_gadget_modules

    # Some kernels may create usb0 through a legacy gadget driver. Prefer that
    # if it already exists.
    if [ -e /sys/class/net/usb0 ]; then
        $BB ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up || return 1
        $BB telnetd -p 2323 -l /bin/sh
        $BB echo "USB network: existing usb0 up on 172.16.42.1"
        $BB echo "Shell: telnet 172.16.42.1 2323"
        return 0
    fi

    $BB mount -t configfs none /sys/kernel/config 2>/dev/null || true
    G=/sys/kernel/config/usb_gadget/flo_diskless
    $BB mkdir -p "$G" || return 1
    $BB echo 0x1d6b > "$G/idVendor"
    $BB echo 0x0104 > "$G/idProduct"
    $BB mkdir -p "$G/strings/0x409"
    $BB echo flo-diskless-test > "$G/strings/0x409/serialnumber"
    $BB echo nexus7_test > "$G/strings/0x409/manufacturer"
    $BB echo "Nexus 7 diskless test" > "$G/strings/0x409/product"
    $BB mkdir -p "$G/configs/c.1/strings/0x409"

    FUNCTION=""
    for candidate in ecm.usb0 ncm.usb0 rndis.usb0; do
        if $BB mkdir "$G/functions/$candidate" 2>/dev/null; then
            FUNCTION="$candidate"
            break
        fi
    done

    if [ -z "$FUNCTION" ]; then
        $BB echo "USB gadget: no ECM/NCM/RNDIS configfs function available"
        return 1
    fi

    $BB echo "$FUNCTION shell" > "$G/configs/c.1/strings/0x409/configuration"
    $BB ln -s "$G/functions/$FUNCTION" "$G/configs/c.1/$FUNCTION" || return 1

    UDC="$($BB ls /sys/class/udc 2>/dev/null | $BB head -n 1)"
    if [ -z "$UDC" ]; then
        $BB echo "USB gadget: no UDC found"
        return 1
    fi

    $BB echo "$UDC" > "$G/UDC" || return 1

    i=0
    while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 10 ]; do
        $BB sleep 1
        i=$((i + 1))
    done

    if [ ! -e /sys/class/net/usb0 ]; then
        $BB echo "USB gadget: $FUNCTION bound to $UDC but usb0 did not appear"
        return 1
    fi

    $BB ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up || return 1
    $BB telnetd -p 2323 -l /bin/sh
    $BB echo "USB gadget: $FUNCTION up on 172.16.42.1 via $UDC"
    $BB echo "Shell: telnet 172.16.42.1 2323"
    return 0
}

start_usb_shell || $BB echo "USB shell unavailable; staying alive in local shell"

$BB echo
$BB echo "Useful checks:"
$BB echo "  cat /proc/partitions"
$BB echo "  ls -l /dev/mmcblk*"
$BB echo "  lsmod"
$BB echo "  dmesg | grep -i -E 'mmc|usb|udc|gadget'"
$BB echo "  uptime"
$BB echo
$BB echo "Dropping to local console shell as a fallback."

exec /bin/busybox sh
