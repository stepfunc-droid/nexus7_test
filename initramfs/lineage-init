#!/bin/busybox sh

BB=/bin/busybox
export PATH=/bin:/sbin

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys

# lineageos_flo_defconfig has CONFIG_DEVTMPFS disabled, so create the
# minimum device nodes needed by the probe explicitly at runtime.
$BB mkdir -p /dev/pts /tmp /www
[ -e /dev/null ]    || $BB mknod /dev/null    c 1 3
[ -e /dev/zero ]    || $BB mknod /dev/zero    c 1 5
[ -e /dev/tty ]     || $BB mknod /dev/tty     c 5 0
[ -e /dev/console ] || $BB mknod /dev/console c 5 1
[ -e /dev/ptmx ]    || $BB mknod /dev/ptmx    c 5 2
$BB chmod 666 /dev/null /dev/zero /dev/tty /dev/ptmx
$BB chmod 600 /dev/console

DEVPTS_STATUS=FAIL
if $BB mount -t devpts devpts /dev/pts; then
    DEVPTS_STATUS=OK
fi

# NBD is built in and uses block major 43 on this kernel. With devtmpfs
# disabled the /dev/nbd* nodes must be created manually.
if $BB grep -qE '^[[:space:]]*43[[:space:]]+nbd$' /proc/devices; then
    i=0
    while [ "$i" -lt 4 ]; do
        [ -e "/dev/nbd$i" ] || $BB mknod "/dev/nbd$i" b 43 "$i"
        i=$((i + 1))
    done
fi

$BB echo
$BB echo "=== Lineage flo USB/NBD probe ==="
$BB echo "Kernel: $($BB uname -a)"
$BB echo "cmdline: $($BB cat /proc/cmdline)"
$BB echo "devpts: $DEVPTS_STATUS"
$BB echo

# Wait for the built-in g_ether usb0 interface.
i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 30 ]; do
    $BB sleep 1
    i=$((i + 1))
done

if [ ! -e /sys/class/net/usb0 ]; then
    $BB echo "ERROR: usb0 not found"
    while true; do $BB sleep 3600; done
fi

$BB ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up

# Capture everything useful in one file so diagnostics do not depend on PTYs.
{
    echo "=== NEXUS DIAG ==="
    echo
    echo "DEVPTS_STATUS=$DEVPTS_STATUS"

    echo
    echo "--- uname ---"
    $BB uname -a

    echo
    echo "--- cmdline ---"
    $BB cat /proc/cmdline

    echo
    echo "--- mounts ---"
    $BB cat /proc/mounts

    echo
    echo "--- device nodes ---"
    $BB ls -l /dev/null /dev/tty /dev/console /dev/ptmx
    $BB ls -ld /dev/pts
    $BB ls -l /dev/pts

    echo
    echo "--- NBD ---"
    $BB grep -i nbd /proc/devices || echo "NBD NOT PRESENT"
    $BB ls -l /dev/nbd* 2>&1

    echo
    echo "--- partitions ---"
    $BB cat /proc/partitions

    echo
    echo "--- processes ---"
    $BB ps

    echo
    echo "--- BusyBox applets ---"
    $BB --list

    echo
    echo "=== END ==="
} > /www/diag.txt 2>&1

# HTTP diagnostics require no PTY and are therefore the primary diagnostic path.
if $BB --list | $BB grep -qx httpd; then
    $BB echo "HTTP diagnostics: http://172.16.42.1:2325/diag.txt"
    $BB httpd -p 2325 -h /www
else
    $BB echo "WARNING: BusyBox httpd applet unavailable"
fi

# Raw interactive shell. tcpsvd redirects the accepted socket directly to the
# child process, so this path does not require telnet negotiation or a PTY.
if $BB --list | $BB grep -qx tcpsvd; then
    $BB tcpsvd -E 0 2324 /bin/busybox sh &
    $BB echo "Raw shell: nc 172.16.42.1 2324"
else
    $BB echo "WARNING: BusyBox tcpsvd applet unavailable"
fi

# Keep telnet as a secondary path now that /dev/ptmx + devpts are present.
if $BB --list | $BB grep -qx telnetd; then
    (
        while true; do
            $BB telnetd -F -p 2323 -l /bin/sh
            $BB sleep 1
        done
    ) &
    $BB echo "Telnet shell: telnet 172.16.42.1 2323"
fi

while true; do
    $BB sleep 3600
done
