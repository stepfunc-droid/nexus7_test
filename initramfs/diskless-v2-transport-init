#!/bin/busybox sh
set -u

BB=/bin/busybox
export PATH=/bin:/sbin
HOST=172.16.42.2
PORT=10810
NEXUS_IP=172.16.42.1
STATUS=/www/status.txt
DIAG=/www/diag.txt
NBD_LOG=/tmp/nbd.log
LAYOUT=/etc/diskless-v2-layout

mkdirs() {
    $BB mkdir -p /proc /sys /dev/pts /tmp /www /mnt/system /mnt/vendor /mnt/cache /mnt/data /mnt/persist
}

node() {
    path="$1" type="$2" major="$3" minor="$4" mode="$5"
    [ -e "$path" ] || $BB mknod "$path" "$type" "$major" "$minor"
    $BB chmod "$mode" "$path" 2>/dev/null || true
}

set_status() {
    {
        echo "DISKLESS_V2_TRANSPORT_STATUS=$1"
        echo "detail=${2:-}"
        echo "uptime=$($BB cat /proc/uptime 2>/dev/null || true)"
    } > "$STATUS"
}

fail() {
    set_status FAIL "$*"
    echo "ERROR: $*" >&2
    write_diag
    while true; do $BB sleep 3600; done
}

nbd_kernel_pid() {
    if [ -r /sys/block/nbd0/pid ]; then
        pid="$($BB cat /sys/block/nbd0/pid 2>/dev/null || true)"
        case "$pid" in
            ''|*[!0-9]*) return 1 ;;
            0) return 1 ;;
            *) echo "$pid"; return 0 ;;
        esac
    fi
    return 1
}

nbd_alive() {
    pid="$(nbd_kernel_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    sectors="$(partition_sectors nbd0)"
    [ -n "$sectors" ] && [ "$sectors" -gt 0 ] 2>/dev/null
}

write_diag() {
    {
        echo "=== DISKLESS V2 TRANSPORT DIAG ==="
        echo
        echo "--- status ---"
        $BB cat "$STATUS" 2>/dev/null || true
        echo
        echo "--- cmdline ---"
        $BB cat /proc/cmdline 2>/dev/null || true
        echo
        echo "--- NBD module parameters ---"
        for f in /sys/module/nbd/parameters/*; do
            [ -f "$f" ] || continue
            echo "$f=$($BB cat "$f" 2>/dev/null)"
        done
        echo
        echo "--- NBD session ---"
        if pid="$(nbd_kernel_pid 2>/dev/null)"; then
            echo "kernel_nbd_pid=$pid"
        else
            echo "kernel_nbd_pid=absent"
        fi
        echo "nbd0_sectors=$(partition_sectors nbd0 2>/dev/null || true)"
        echo
        echo "--- partitions ---"
        $BB cat /proc/partitions 2>/dev/null || true
        echo
        echo "--- mounts ---"
        $BB cat /proc/mounts 2>/dev/null || true
        echo
        echo "--- network ---"
        $BB ifconfig usb0 2>&1 || true
        echo
        echo "--- NBD log ---"
        $BB cat "$NBD_LOG" 2>/dev/null || true
        echo
        echo "--- last_kmsg availability ---"
        if [ -r /proc/last_kmsg ]; then
            echo "present"
        else
            echo "absent"
        fi
        echo
        echo "=== END ==="
    } > "$DIAG" 2>&1
}

require_applet() {
    $BB --list | $BB grep -qx "$1" || fail "BusyBox applet missing: $1"
}

partition_sectors() {
    dev="$1"
    $BB awk -v d="$dev" '$4 == d { print $3 * 2; exit }' /proc/partitions
}

validate_partition() {
    dev="$1" expected="$2"
    actual="$(partition_sectors "$dev")"
    [ -n "$actual" ] || fail "$dev missing from /proc/partitions"
    [ "$actual" = "$expected" ] || fail "$dev sectors=$actual expected=$expected"
}

mkdirs
$BB mount -t proc proc /proc || exit 1
$BB mount -t sysfs sysfs /sys || exit 1

node /dev/null c 1 3 666
node /dev/zero c 1 5 666
node /dev/random c 1 8 666
node /dev/urandom c 1 9 666
node /dev/tty c 5 0 666
node /dev/console c 5 1 600
node /dev/ptmx c 5 2 666
$BB mount -t devpts devpts /dev/pts 2>/dev/null || true

# Linux 3.4 NBD with max_part=8 rounds partition minor space to 16 minors.
# nbd0 is minor 0 and nbd0p1..p15 are minors 1..15.
node /dev/nbd0 b 43 0 600
i=1
while [ "$i" -le 15 ]; do
    node "/dev/nbd0p$i" b 43 "$i" 600
    i=$((i + 1))
done

set_status BOOTING "transport init started"

[ -r "$LAYOUT" ] || fail "layout contract missing: $LAYOUT"
. "$LAYOUT"

for applet in nbd-client ifconfig mount umount dd md5sum sync awk grep date; do
    require_applet "$applet"
done

# Make kernel oops fatal during this acceptance test so persistent ram_console
# can capture a real crash instead of leaving a half-alive transport.
[ -w /proc/sys/kernel/panic_on_oops ] && echo 1 > /proc/sys/kernel/panic_on_oops
[ -w /proc/sys/kernel/panic ] && echo 5 > /proc/sys/kernel/panic

# Make previous kernel crash evidence available before the acceptance test starts.
if [ -r /proc/last_kmsg ]; then
    $BB cat /proc/last_kmsg > /www/last_kmsg.txt 2>/dev/null || true
fi

# Wait for the only USB gadget used by diskless-v2.
i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 60 ]; do
    $BB sleep 1
    i=$((i + 1))
done
[ -e /sys/class/net/usb0 ] || fail "usb0 did not appear"

$BB ifconfig usb0 "$NEXUS_IP" netmask 255.255.255.0 up || fail "failed to configure usb0"

# Diagnostics are available as soon as the link is configured.
if $BB --list | $BB grep -qx httpd; then
    $BB httpd -p 2325 -h /www
fi
if $BB --list | $BB grep -qx tcpsvd; then
    $BB tcpsvd -E 0 2324 /bin/busybox sh &
fi

# macOS may need a moment to re-create/configure its USB Ethernet interface.
# BusyBox nbd-client daemonizes after NBD_DO_IT is established, so the PID of
# the launcher ($!) is not a session-liveness signal. The Linux NBD driver
# creates /sys/block/nbd0/pid for the lifetime of NBD_DO_IT; use that plus
# non-zero device capacity as the authoritative state.
: > "$NBD_LOG"
NBD_ATTEMPT=0
sectors=""

start_nbd() {
    NBD_ATTEMPT=$((NBD_ATTEMPT + 1))
    set_status CONNECTING "attempt=$NBD_ATTEMPT attaching $HOST:$PORT"
    echo "=== attach attempt $NBD_ATTEMPT ===" >> "$NBD_LOG"
    (
        $BB nbd-client "$HOST" "$PORT" /dev/nbd0
    ) >> "$NBD_LOG" 2>&1 &
}

start_nbd
i=0
LAST_RETRY=0
while [ "$i" -lt 480 ]; do
    sectors="$(partition_sectors nbd0)"
    if nbd_alive; then
        break
    fi

    # Retry only when there is no kernel NBD_DO_IT session and no capacity.
    # Give each launcher several seconds to reach NBD_DO_IT before retrying.
    if ! nbd_kernel_pid >/dev/null 2>&1 && { [ -z "$sectors" ] || [ "$sectors" -eq 0 ] 2>/dev/null; }; then
        if [ $((i - LAST_RETRY)) -ge 20 ]; then
            start_nbd
            LAST_RETRY=$i
        fi
    fi

    $BB usleep 250000
    i=$((i + 1))
done
nbd_alive || fail "nbd0 never established kernel session/capacity after $NBD_ATTEMPT attempts"

# A partition rescan is needed on some old block-layer paths after NBD_SET_SIZE.
if $BB --list | $BB grep -qx blockdev; then
    $BB blockdev --rereadpt /dev/nbd0 >> "$NBD_LOG" 2>&1 || true
fi

# Opening a partition node also gives the old block layer an opportunity to
# honour bd_invalidated and scan the MBR/EBR chain.
i=0
while [ "$i" -lt 80 ]; do
    ok=1
    for p in 1 2 3 5 6 7; do
        $BB grep -qE "[[:space:]]nbd0p${p}$" /proc/partitions || ok=0
    done
    [ "$ok" = 1 ] && break
    $BB dd if=/dev/nbd0p1 of=/dev/null bs=512 count=1 >/dev/null 2>&1 || true
    $BB usleep 250000
    i=$((i + 1))
done

validate_partition nbd0p1 "$P1_SECTORS"
validate_partition nbd0p2 "$P2_SECTORS"
validate_partition nbd0p3 "$P3_SECTORS"
validate_partition nbd0p5 "$P5_SECTORS"
validate_partition nbd0p6 "$P6_SECTORS"
validate_partition nbd0p7 "$P7_SECTORS"

set_status MOUNTING "partition table verified"
$BB mount -t ext4 -o ro,noload /dev/nbd0p1 /mnt/system || fail "system mount failed"
$BB mount -t ext4 -o ro,noload /dev/nbd0p2 /mnt/vendor || fail "vendor mount failed"
$BB mount -t ext4 /dev/nbd0p3 /mnt/cache || fail "cache mount failed"
$BB mount -t ext4 /dev/nbd0p5 /mnt/data || fail "userdata mount failed"
$BB mount -t ext4 /dev/nbd0p6 /mnt/persist || fail "persist mount failed"
# p7 is intentionally raw/reserved metadata in layout.json. Validate that the
# block partition exists, but do not invent an ext4 filesystem or mount it.

# One explicit integrity test: random payload -> sync -> checksum -> unmount ->
# remount -> checksum. This catches a transport that only appears writable.
set_status INTEGRITY "running userdata remount/checksum test"
$BB dd if=/dev/urandom of=/mnt/data/.diskless-v2-integrity.bin bs=1048576 count=8 2>/tmp/dd-integrity.log || fail "integrity write failed"
$BB sync
HASH1="$($BB md5sum /mnt/data/.diskless-v2-integrity.bin | $BB awk '{print $1}')"
[ -n "$HASH1" ] || fail "could not checksum integrity payload"
$BB umount /mnt/data || fail "userdata unmount failed"
$BB mount -t ext4 /dev/nbd0p5 /mnt/data || fail "userdata remount failed"
HASH2="$($BB md5sum /mnt/data/.diskless-v2-integrity.bin | $BB awk '{print $1}')"
[ "$HASH1" = "$HASH2" ] || fail "userdata checksum mismatch after remount"
$BB rm -f /mnt/data/.diskless-v2-integrity.bin
$BB sync

# Ten-minute transport acceptance under simultaneous RO reads and RW traffic.
# status.txt is rewritten after every cycle so the Mac can observe progress.
START="$($BB date +%s)"
END=$((START + 600))
CYCLE=0
set_status STRESS "10-minute transport acceptance started"

while [ "$($BB date +%s)" -lt "$END" ]; do
    CYCLE=$((CYCLE + 1))
    KERNEL_NBD_PID="$(nbd_kernel_pid 2>/dev/null || true)"
    set_status STRESS "cycle=$CYCLE kernel_nbd_pid=${KERNEL_NBD_PID:-absent}"

    # Read both immutable filesystems directly through partition devices.
    $BB dd if=/dev/nbd0p1 of=/dev/null bs=1048576 count=64 2>/tmp/dd-system.log || fail "system read failed at cycle $CYCLE"
    $BB dd if=/dev/nbd0p2 of=/dev/null bs=1048576 count=64 2>/tmp/dd-vendor.log || fail "vendor read failed at cycle $CYCLE"

    # Exercise ext4 journal + NBD writes/reads repeatedly on userdata.
    $BB dd if=/dev/zero of=/mnt/data/.diskless-v2-stress.bin bs=1048576 count=32 2>/tmp/dd-write.log || fail "userdata write failed at cycle $CYCLE"
    $BB sync
    $BB dd if=/mnt/data/.diskless-v2-stress.bin of=/dev/null bs=1048576 2>/tmp/dd-read.log || fail "userdata read failed at cycle $CYCLE"

    nbd_alive || fail "kernel NBD session disappeared during cycle $CYCLE"
    write_diag

done

$BB rm -f /mnt/data/.diskless-v2-stress.bin
$BB sync
set_status PASS "10-minute single-NBD transport acceptance passed cycles=$CYCLE checksum=$HASH2"
write_diag

echo "DISKLESS_V2_TRANSPORT_VERIFIED=1"
echo "HTTP: http://172.16.42.1:2325/status.txt"
echo "DIAG: http://172.16.42.1:2325/diag.txt"

while true; do
    $BB sleep 3600
done
