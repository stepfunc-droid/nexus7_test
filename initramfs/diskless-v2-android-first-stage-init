#!/bin/busybox sh
set -u

BB=/bin/busybox
export PATH=/bin:/sbin
HOST=172.16.42.2
PORT=10810
NEXUS_IP=172.16.42.1
STATUS=/www/status.txt
FIRST_STAGE=/www/first-stage.txt
KMSG=/www/kmsg.txt
NBD_LOG=/tmp/nbd.log
LAYOUT=/etc/diskless-v2-layout

mkdirs() {
    $BB mkdir -p /proc /sys /dev/pts /tmp /www
}

node() {
    path="$1" type="$2" major="$3" minor="$4" mode="$5"
    [ -e "$path" ] || $BB mknod "$path" "$type" "$major" "$minor"
    $BB chmod "$mode" "$path" 2>/dev/null || true
}

set_status() {
    {
        echo "DISKLESS_V2_ANDROID_PROBE_STATUS=$1"
        echo "detail=${2:-}"
        echo "uptime=$($BB cat /proc/uptime 2>/dev/null || true)"
    } > "$STATUS"
}

nbd_kernel_pid() {
    if [ -r /sys/block/nbd0/pid ]; then
        pid="$($BB cat /sys/block/nbd0/pid 2>/dev/null || true)"
        case "$pid" in
            ''|*[!0-9]*) return 1 ;;
            0) return 1 ;;
            *) echo "$pid"; return 0 ;;
        esac
    fi
    return 1
}

partition_sectors() {
    dev="$1"
    $BB awk -v d="$dev" '$4 == d { print $3 * 2; exit }' /proc/partitions
}

nbd_alive() {
    pid="$(nbd_kernel_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    sectors="$(partition_sectors nbd0)"
    [ -n "$sectors" ] && [ "$sectors" -gt 0 ] 2>/dev/null
}

fail() {
    set_status FAIL "$*"
    {
        echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=FAIL"
        echo "FAIL_REASON=$*"
    } > "$FIRST_STAGE"
    echo "diskless-v2: Android first-stage probe FAIL: $*" > /dev/kmsg 2>/dev/null || true
    while true; do $BB sleep 3600; done
}

validate_partition() {
    dev="$1" expected="$2"
    actual="$(partition_sectors "$dev")"
    [ -n "$actual" ] || fail "$dev missing from /proc/partitions"
    [ "$actual" = "$expected" ] || fail "$dev sectors=$actual expected=$expected"
}

mkdirs
$BB mount -t proc proc /proc || exit 1
$BB mount -t sysfs sysfs /sys || exit 1

node /dev/null c 1 3 666
node /dev/zero c 1 5 666
node /dev/random c 1 8 666
node /dev/urandom c 1 9 666
node /dev/kmsg c 1 11 600
node /dev/tty c 5 0 666
node /dev/console c 5 1 600
node /dev/ptmx c 5 2 666
$BB mount -t devpts devpts /dev/pts 2>/dev/null || true

# Linux 3.4 NBD with nbd.max_part=8 allocates 16 minors for nbd0.
node /dev/nbd0 b 43 0 600
i=1
while [ "$i" -le 15 ]; do
    node "/dev/nbd0p$i" b 43 "$i" 600
    i=$((i + 1))
done

[ -r "$LAYOUT" ] || fail "layout contract missing: $LAYOUT"
. "$LAYOUT"

set_status BOOTING "single-NBD supervisor started; Android not yet executed"
: > "$FIRST_STAGE"
: > "$KMSG"
: > "$NBD_LOG"

[ -w /proc/sys/kernel/panic_on_oops ] && echo 1 > /proc/sys/kernel/panic_on_oops
[ -w /proc/sys/kernel/panic ] && echo 5 > /proc/sys/kernel/panic

if [ -r /proc/last_kmsg ]; then
    $BB cat /proc/last_kmsg > /www/last_kmsg.txt 2>/dev/null || true
fi

# Wait for the dedicated g_ether link.
i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 60 ]; do
    $BB sleep 1
    i=$((i + 1))
done
[ -e /sys/class/net/usb0 ] || fail "usb0 did not appear"
$BB ifconfig usb0 "$NEXUS_IP" netmask 255.255.255.0 up || fail "failed to configure usb0"

# Keep diagnostics on the already-proven diskless USB network. These processes
# are diagnostic-only; PID 1 is intentionally stopped as soon as first-stage
# system/vendor mounts are proven.
if $BB --list | $BB grep -qx httpd; then
    $BB httpd -p 2325 -h /www
fi
$BB cat /proc/kmsg >> "$KMSG" 2>/dev/null &

start_nbd() {
    NBD_ATTEMPT=$((NBD_ATTEMPT + 1))
    set_status CONNECTING "attempt=$NBD_ATTEMPT attaching $HOST:$PORT"
    echo "=== attach attempt $NBD_ATTEMPT ===" >> "$NBD_LOG"
    ($BB nbd-client "$HOST" "$PORT" /dev/nbd0) >> "$NBD_LOG" 2>&1 &
}

NBD_ATTEMPT=0
LAST_RETRY=0
start_nbd
i=0
while [ "$i" -lt 480 ]; do
    if nbd_alive; then
        break
    fi
    sectors="$(partition_sectors nbd0)"
    if ! nbd_kernel_pid >/dev/null 2>&1 && { [ -z "$sectors" ] || [ "$sectors" -eq 0 ] 2>/dev/null; }; then
        if [ $((i - LAST_RETRY)) -ge 20 ]; then
            start_nbd
            LAST_RETRY=$i
        fi
    fi
    $BB usleep 250000
    i=$((i + 1))
done
nbd_alive || fail "nbd0 never established kernel session/capacity after $NBD_ATTEMPT attempts"

if $BB --list | $BB grep -qx blockdev; then
    $BB blockdev --rereadpt /dev/nbd0 >> "$NBD_LOG" 2>&1 || true
fi

i=0
while [ "$i" -lt 80 ]; do
    ok=1
    for p in 1 2 3 5 6 7; do
        $BB grep -qE "[[:space:]]nbd0p${p}$" /proc/partitions || ok=0
    done
    [ "$ok" = 1 ] && break
    $BB dd if=/dev/nbd0p1 of=/dev/null bs=512 count=1 >/dev/null 2>&1 || true
    $BB usleep 250000
    i=$((i + 1))
done

validate_partition nbd0p1 "$P1_SECTORS"
validate_partition nbd0p2 "$P2_SECTORS"
validate_partition nbd0p3 "$P3_SECTORS"
validate_partition nbd0p5 "$P5_SECTORS"
validate_partition nbd0p6 "$P6_SECTORS"
validate_partition nbd0p7 "$P7_SECTORS"

BASE_NBD_PID="$(nbd_kernel_pid 2>/dev/null || true)"
[ -n "$BASE_NBD_PID" ] || fail "kernel NBD pid missing before Android handoff"

# The watcher does not mount anything. It observes Android first-stage init's
# own mount namespace. Once both required NBD mounts appear it records the exact
# sources and immediately SIGSTOPs PID 1, preventing Phase-6/late-boot behavior
# from contaminating this binary first-stage experiment.
(
    ticks=0
    while [ "$ticks" -lt 1200 ]; do
        SYSTEM_SRC=""
        VENDOR_SRC=""
        if [ -r /proc/mounts ]; then
            while read src mnt fstype opts rest; do
                [ "$mnt" = "/system" ] && SYSTEM_SRC="$src"
                [ "$mnt" = "/vendor" ] && VENDOR_SRC="$src"
            done < /proc/mounts
        fi

        system_ok=0
        vendor_ok=0
        case "$SYSTEM_SRC" in *nbd0p1) system_ok=1 ;; esac
        case "$VENDOR_SRC" in *nbd0p2) vendor_ok=1 ;; esac

        if [ "$system_ok" = 1 ] && [ "$vendor_ok" = 1 ]; then
            AFTER_NBD_PID=""
            if [ -r /sys/block/nbd0/pid ]; then
                IFS= read -r AFTER_NBD_PID < /sys/block/nbd0/pid || true
            fi
            if [ "$AFTER_NBD_PID" != "$BASE_NBD_PID" ]; then
                {
                    echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=FAIL"
                    echo "FAIL_REASON=NBD session changed during first-stage mount"
                    echo "nbd_pid_before=$BASE_NBD_PID"
                    echo "nbd_pid_after=$AFTER_NBD_PID"
                    echo "system_source=$SYSTEM_SRC"
                    echo "vendor_source=$VENDOR_SRC"
                } > "$FIRST_STAGE"
                echo "diskless-v2: first-stage mounts visible but NBD pid changed" > /dev/kmsg 2>/dev/null || true
                kill -STOP 1
                exit 1
            fi

            {
                echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=PASS"
                echo "nbd_pid_before=$BASE_NBD_PID"
                echo "nbd_pid_after=$AFTER_NBD_PID"
                echo "system_source=$SYSTEM_SRC"
                echo "vendor_source=$VENDOR_SRC"
                echo "pid1_action=SIGSTOP-after-first-stage-mounts"
            } > "$FIRST_STAGE"
            echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=PASS system=$SYSTEM_SRC vendor=$VENDOR_SRC nbd_pid=$AFTER_NBD_PID" > /dev/kmsg 2>/dev/null || true
            {
                echo "DISKLESS_V2_ANDROID_PROBE_STATUS=FIRST_STAGE_PASS"
                echo "detail=Android mounted system/vendor from single NBD; PID 1 intentionally stopped"
            } > "$STATUS"
            kill -STOP 1
            exit 0
        fi

        # Once /system is visible Android is entering SwitchRoot and /vendor
        # follows immediately. Poll much faster here so the observer can stop
        # PID 1 before first-stage frees the old ramdisk that contains BusyBox.
        if [ "$system_ok" = 1 ]; then
            $BB usleep 1000
        else
            $BB usleep 100000
        fi
        ticks=$((ticks + 1))
    done

    {
        echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=FAIL"
        echo "FAIL_REASON=timeout waiting for Android first-stage system/vendor mounts"
        echo "nbd_pid_before=$BASE_NBD_PID"
    } > "$FIRST_STAGE"
    echo "diskless-v2: first-stage mount watcher timeout" > /dev/kmsg 2>/dev/null || true
    set_status FIRST_STAGE_FAIL "timeout waiting for system/vendor NBD mounts"
    kill -STOP 1
    exit 1
) &

set_status HANDOFF "single NBD verified; exec original Lineage first-stage init"
echo "diskless-v2: handing off to original Lineage first-stage init nbd_pid=$BASE_NBD_PID" > /dev/kmsg 2>/dev/null || true

# The probe itself mounted proc, sysfs and devpts. Android first-stage will
# create fresh instances of all three. Leaving the old devpts mounted is fatal:
# SwitchRoot() enumerates /proc/mounts and tries to MS_MOVE every old mount into
# /system; after Android overlays /dev with tmpfs the old /dev/pts path is no
# longer a movable mount path. Remove all probe-owned VFS mounts before exec.
$BB umount /dev/pts || fail "umount /dev/pts failed before Android handoff"
$BB umount /sys || fail "umount /sys failed before Android handoff"
# /proc/kmsg is intentionally held open by the diagnostic reader. Lazy detach
# removes the probe's proc mount from the namespace while preserving that open
# file description until the reader exits.
$BB umount -l /proc || fail "lazy umount /proc failed before Android handoff"

exec /init.android
