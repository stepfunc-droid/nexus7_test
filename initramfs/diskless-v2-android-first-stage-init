#!/bin/busybox sh
set -u

BB=/bin/busybox
export PATH=/bin:/sbin
HOST=172.16.42.2
PORT=10810
KMSG_PORT=11000
NEXUS_IP=172.16.42.1
STATUS=/www/status.txt
FIRST_STAGE=/www/first-stage.txt
KMSG=/www/kmsg.txt
NBD_LOG=/tmp/nbd.log
LAYOUT=/etc/diskless-v2-layout
KMSG_FIFO=/tmp/phase5d-kmsg-live

mkdirs() {
    $BB mkdir -p /proc /sys /dev/pts /tmp /www
}

node() {
    path="$1" type="$2" major="$3" minor="$4" mode="$5"
    [ -e "$path" ] || $BB mknod "$path" "$type" "$major" "$minor"
    $BB chmod "$mode" "$path" 2>/dev/null || true
}

set_status() {
    {
        echo "DISKLESS_V2_ANDROID_PROBE_STATUS=$1"
        echo "detail=${2:-}"
        echo "uptime=$($BB cat /proc/uptime 2>/dev/null || true)"
    } > "$STATUS"
}

nbd_kernel_pid() {
    if [ -r /sys/block/nbd0/pid ]; then
        pid="$($BB cat /sys/block/nbd0/pid 2>/dev/null || true)"
        case "$pid" in
            ''|*[!0-9]*) return 1 ;;
            0) return 1 ;;
            *) echo "$pid"; return 0 ;;
        esac
    fi
    return 1
}

partition_sectors() {
    dev="$1"
    $BB awk -v d="$dev" '$4 == d { print $3 * 2; exit }' /proc/partitions
}

nbd_alive() {
    pid="$(nbd_kernel_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    sectors="$(partition_sectors nbd0)"
    [ -n "$sectors" ] && [ "$sectors" -gt 0 ] 2>/dev/null
}

fail() {
    set_status FAIL "$*"
    {
        echo "DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=FAIL"
        echo "FAIL_REASON=$*"
    } > "$FIRST_STAGE"
    echo "diskless-v2: Android first-stage probe FAIL: $*" > /dev/kmsg 2>/dev/null || true
    while true; do $BB sleep 3600; done
}

require_applet() {
    $BB --list | $BB grep -qx "$1" || fail "BusyBox applet missing: $1"
}

validate_partition() {
    dev="$1" expected="$2"
    actual="$(partition_sectors "$dev")"
    [ -n "$actual" ] || fail "$dev missing from /proc/partitions"
    [ "$actual" = "$expected" ] || fail "$dev sectors=$actual expected=$expected"
}

mkdirs
$BB mount -t proc proc /proc || exit 1
$BB mount -t sysfs sysfs /sys || exit 1

node /dev/null c 1 3 666
node /dev/zero c 1 5 666
node /dev/random c 1 8 666
node /dev/urandom c 1 9 666
node /dev/kmsg c 1 11 600
node /dev/tty c 5 0 666
node /dev/console c 5 1 600
node /dev/ptmx c 5 2 666
$BB mount -t devpts devpts /dev/pts 2>/dev/null || true

# Linux 3.4 NBD with nbd.max_part=8 allocates 16 minors for nbd0.
node /dev/nbd0 b 43 0 600
i=1
while [ "$i" -le 15 ]; do
    node "/dev/nbd0p$i" b 43 "$i" 600
    i=$((i + 1))
done

[ -r "$LAYOUT" ] || fail "layout contract missing: $LAYOUT"
. "$LAYOUT"

for applet in nbd-client ifconfig mount umount awk grep dd httpd nc tee mkfifo; do
    require_applet "$applet"
done

set_status BOOTING "single-NBD supervisor started; Android not yet executed"
: > "$FIRST_STAGE"
: > "$KMSG"
: > "$NBD_LOG"

[ -w /proc/sys/kernel/panic_on_oops ] && echo 1 > /proc/sys/kernel/panic_on_oops
[ -w /proc/sys/kernel/panic ] && echo 5 > /proc/sys/kernel/panic

if [ -r /proc/last_kmsg ]; then
    $BB cat /proc/last_kmsg > /www/last_kmsg.txt 2>/dev/null || true
fi

i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 60 ]; do
    $BB sleep 1
    i=$((i + 1))
done
[ -e /sys/class/net/usb0 ] || fail "usb0 did not appear"
$BB ifconfig usb0 "$NEXUS_IP" netmask 255.255.255.0 up || fail "failed to configure usb0"

$BB httpd -p 2325 -h /www

start_nbd() {
    NBD_ATTEMPT=$((NBD_ATTEMPT + 1))
    set_status CONNECTING "attempt=$NBD_ATTEMPT attaching $HOST:$PORT"
    echo "=== attach attempt $NBD_ATTEMPT ===" >> "$NBD_LOG"
    ($BB nbd-client "$HOST" "$PORT" /dev/nbd0) >> "$NBD_LOG" 2>&1 &
}

NBD_ATTEMPT=0
LAST_RETRY=0
start_nbd
i=0
while [ "$i" -lt 480 ]; do
    if nbd_alive; then
        break
    fi
    sectors="$(partition_sectors nbd0)"
    if ! nbd_kernel_pid >/dev/null 2>&1 && { [ -z "$sectors" ] || [ "$sectors" -eq 0 ] 2>/dev/null; }; then
        if [ $((i - LAST_RETRY)) -ge 20 ]; then
            start_nbd
            LAST_RETRY=$i
        fi
    fi
    $BB usleep 250000
    i=$((i + 1))
done
nbd_alive || fail "nbd0 never established kernel session/capacity after $NBD_ATTEMPT attempts"

if $BB --list | $BB grep -qx blockdev; then
    $BB blockdev --rereadpt /dev/nbd0 >> "$NBD_LOG" 2>&1 || true
fi

i=0
while [ "$i" -lt 80 ]; do
    ok=1
    for p in 1 2 3 5 6 7; do
        $BB grep -qE "[[:space:]]nbd0p${p}$" /proc/partitions || ok=0
    done
    [ "$ok" = 1 ] && break
    $BB dd if=/dev/nbd0p1 of=/dev/null bs=512 count=1 >/dev/null 2>&1 || true
    $BB usleep 250000
    i=$((i + 1))
done

validate_partition nbd0p1 "$P1_SECTORS"
validate_partition nbd0p2 "$P2_SECTORS"
validate_partition nbd0p3 "$P3_SECTORS"
validate_partition nbd0p5 "$P5_SECTORS"
validate_partition nbd0p6 "$P6_SECTORS"
validate_partition nbd0p7 "$P7_SECTORS"

BASE_NBD_PID="$(nbd_kernel_pid 2>/dev/null || true)"
[ -n "$BASE_NBD_PID" ] || fail "kernel NBD pid missing before Android handoff"

# Phase 5D evidence must survive any subsequent normal boot.  A single reader
# owns /proc/kmsg and tees every record to both the old-ramdisk diagnostic file
# and a live TCP stream to the Mac.  The same stream is also the first-stage
# stopper: it watches Android's own fs_mgr success records and SIGSTOPs PID 1
# immediately after both NBD-backed first-stage mounts have succeeded.
$BB rm -f "$KMSG_FIFO"
$BB mkfifo "$KMSG_FIFO" || fail "could not create live-kmsg FIFO"
($BB nc "$HOST" "$KMSG_PORT" < "$KMSG_FIFO") &
KMSG_NC_PID=$!
$BB sleep 1
kill -0 "$KMSG_NC_PID" 2>/dev/null || fail "live-kmsg TCP stream could not connect to $HOST:$KMSG_PORT"

# These descriptors are opened before Android moves /sys and /dev during
# SwitchRoot.  They remain usable by the observer after the namespace paths
# have moved, so the observer never depends on old-root path lookup.
exec 6</sys/block/nbd0/pid || fail "could not pin NBD pid sysfs descriptor"
exec 7>/dev/kmsg || fail "could not pin /dev/kmsg descriptor"

(
    SYSTEM_SEEN=0
    VENDOR_SEEN=0

    $BB cat /proc/kmsg | $BB tee -a "$KMSG" "$KMSG_FIFO" | while IFS= read -r line; do
        case "$line" in
            *"__mount(source=/dev/block/nbd0p1,target=/system,type=ext4)=0: Success"*)
                SYSTEM_SEEN=1
                ;;
            *"__mount(source=/dev/block/nbd0p2,target=/vendor,type=ext4)=0: Success"*)
                VENDOR_SEEN=1
                ;;
        esac

        if [ "$SYSTEM_SEEN" = 1 ] && [ "$VENDOR_SEEN" = 1 ]; then
            AFTER_NBD_PID=""
            IFS= read -r AFTER_NBD_PID <&6 || true

            if [ "$AFTER_NBD_PID" = "$BASE_NBD_PID" ]; then
                printf 'DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=PASS nbd_pid_before=%s nbd_pid_after=%s system_source=/dev/block/nbd0p1 vendor_source=/dev/block/nbd0p2 pid1_action=SIGSTOP-after-first-stage-mounts\n' \
                    "$BASE_NBD_PID" "$AFTER_NBD_PID" >&7
            else
                printf 'DISKLESS_V2_ANDROID_FIRST_STAGE_MOUNTS=FAIL reason=NBD-session-changed nbd_pid_before=%s nbd_pid_after=%s\n' \
                    "$BASE_NBD_PID" "$AFTER_NBD_PID" >&7
            fi

            kill -STOP 1
            exit 0
        fi
    done
) &

set_status HANDOFF "single NBD verified; live-kmsg connected; exec original Lineage first-stage init"
printf 'diskless-v2: handing off to original Lineage first-stage init nbd_pid=%s live_kmsg_port=%s\n' \
    "$BASE_NBD_PID" "$KMSG_PORT" >&7

# Remove every VFS mount owned by the probe before Android first-stage starts.
# In particular, leaving devpts mounted causes Lineage SwitchRoot() to fatal
# while trying to MS_MOVE the hidden old /dev/pts mount into /system.
$BB umount /dev/pts || fail "umount /dev/pts failed before Android handoff"
$BB umount /sys || fail "umount /sys failed before Android handoff"
# The kmsg reader intentionally holds the old proc mount open.  Lazy detach
# removes it from the namespace while preserving that open file description.
$BB umount -l /proc || fail "lazy umount /proc failed before Android handoff"

exec /init.android
