#!/bin/busybox sh
set -u

BB=/bin/busybox
export PATH=/bin:/sbin

REPORT_HOST=172.16.42.2
REPORT_PORT=10999
KMSG_PORT=11000

log() {
    $BB echo "[diskless-init] $*" > /dev/console 2>/dev/null || true
}

# Send one-shot stage markers to the Mac. This creates no extra mount and leaves
# no background process behind, so it cannot interfere with Android SwitchRoot.
report() {
    msg="[diskless-init] $*"
    $BB printf '%s\n' "$msg" | $BB nc -w 1 "$REPORT_HOST" "$REPORT_PORT" >/dev/null 2>&1 || true
}

# Minimal early userspace. Android first-stage init will replace /dev with its own
# tmpfs and recreate NBD block nodes from sysfs uevents after we hand over.
$BB mkdir -p /proc /sys /dev
[ -e /dev/null ]    || $BB mknod /dev/null    c 1 3
[ -e /dev/console ] || $BB mknod /dev/console c 5 1
$BB chmod 666 /dev/null 2>/dev/null || true
$BB chmod 600 /dev/console 2>/dev/null || true

$BB mount -t proc proc /proc || {
    log "ERROR: mount /proc failed"
    exec /bin/busybox sh
}
$BB mount -t sysfs sysfs /sys || {
    log "ERROR: mount /sys failed"
    exec /bin/busybox sh
}

# NBD major is 43 on the flo Lineage 3.4 kernel. These temporary nodes are only
# for BusyBox nbd-client. Android init later hides them with its own /dev tmpfs.
i=0
while [ "$i" -lt 5 ]; do
    [ -e "/dev/nbd$i" ] || $BB mknod "/dev/nbd$i" b 43 "$i"
    $BB chmod 600 "/dev/nbd$i" 2>/dev/null || true
    i=$((i + 1))
done

# Wait for built-in g_ether.
i=0
while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 30 ]; do
    $BB sleep 1
    i=$((i + 1))
done

if [ ! -e /sys/class/net/usb0 ]; then
    log "ERROR: usb0 not found"
    exec /bin/busybox sh
fi

$BB ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up || {
    log "ERROR: failed to configure usb0"
    exec /bin/busybox sh
}
report "usb0 configured"

connect_nbd() {
    idx="$1"
    port="$2"
    dev="/dev/nbd$idx"
    sys_pid="/sys/block/nbd$idx/pid"
    launcher_pid=""

    log "connecting nbd$idx -> 172.16.42.2:$port"
    report "connecting nbd$idx port=$port"

    # Retry for up to ~120 seconds, but never launch a second nbd-client while
    # the previous launcher is still alive or the kernel reports an active
    # NBD_DO_IT pid. This prevents multiple clients competing for one /dev/nbdN.
    tick=0
    while [ "$tick" -lt 480 ]; do
        if $BB awk -v n="nbd$idx" '$4==n && $3>0 { found=1 } END { exit !found }' /proc/partitions; then
            size="$($BB blockdev --getsize64 "$dev" 2>/dev/null || $BB echo '?')"
            kernel_pid="$($BB cat "$sys_pid" 2>/dev/null || true)"
            log "nbd$idx connected, size=$size, pid=${kernel_pid:-?}"
            report "nbd$idx connected size=$size pid=${kernel_pid:-?}"
            return 0
        fi

        kernel_pid="$($BB cat "$sys_pid" 2>/dev/null || true)"
        if [ -n "$kernel_pid" ] && [ "$kernel_pid" != "0" ]; then
            # The kernel already has a live NBD_DO_IT task. Give the block size
            # and /proc/partitions time to settle; do not start another client.
            $BB usleep 250000
            tick=$((tick + 1))
            continue
        fi

        if [ -n "$launcher_pid" ] && $BB kill -0 "$launcher_pid" 2>/dev/null; then
            # A connection attempt is still in progress.
            $BB usleep 250000
            tick=$((tick + 1))
            continue
        fi

        # No active kernel NBD task and no live launcher: the previous attempt
        # really failed/exited, so it is safe to retry.
        $BB nbd-client 172.16.42.2 "$port" "$dev" >/dev/null 2>&1 &
        launcher_pid=$!
        $BB usleep 250000
        tick=$((tick + 1))
    done

    log "ERROR: nbd$idx failed to connect to port $port"
    report "ERROR nbd$idx failed port=$port"
    return 1
}

# Fixed diskless layout:
#   nbd0 system   (RO server) 10810
#   nbd1 vendor   (RO server) 10811
#   nbd2 cache    (RW server) 10812
#   nbd3 userdata (RW server) 10813
#   nbd4 persist  (RW server) 10814
connect_nbd 0 10810 || exec /bin/busybox sh
connect_nbd 1 10811 || exec /bin/busybox sh
connect_nbd 2 10812 || exec /bin/busybox sh
connect_nbd 3 10813 || exec /bin/busybox sh
connect_nbd 4 10814 || exec /bin/busybox sh

log "all NBD devices attached; handing over to Android first-stage init"
report "all NBD devices attached"

# Open /proc/kmsg before Android takes over and stream it through a TCP
# connection that is also established before SwitchRoot. The old proc mount is
# detached with MNT_DETACH below, so Android can mount a fresh /proc while the
# already-open kmsg fd remains valid for this diagnostic stream.
report "starting live kmsg stream port=$KMSG_PORT"
$BB cat /proc/kmsg 2>/dev/null | $BB nc "$REPORT_HOST" "$KMSG_PORT" >/dev/null 2>&1 &
report "live kmsg stream launched"

# Android first-stage init expects to mount proc/sysfs itself and treats mount
# failures as fatal, so leave those mount points clean before exec.
report "before umount /sys"
$BB umount /sys || {
    log "ERROR: umount /sys failed"
    report "ERROR umount /sys failed"
    exec /bin/busybox sh
}
report "after umount /sys"

# /proc/kmsg is intentionally held open by the diagnostic streamer. A normal
# umount would return EBUSY, so detach the proc mount lazily. It disappears from
# this mount namespace immediately, while the open fd keeps the old proc mount
# alive privately until the streamer exits.
report "before lazy umount /proc"
$BB umount -l /proc || {
    log "ERROR: lazy umount /proc failed"
    report "ERROR lazy umount /proc failed"
    exec /bin/busybox sh
}
report "after lazy umount /proc"

report "exec /init.android"
exec /init.android
